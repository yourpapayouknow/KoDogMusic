import { Theme } from "../theme.slint";
// 凹槽轨道与立体圆钮。
export component SeekBar inherits Rectangle {
    in property <float> value;
    in property <float> maximum: 1;
    in property <bool> volume: false;
    callback changed(float, bool);
    property <float> shown: area.pressed ? max(0, min(1, area.mouse-x / self.width)) : (maximum > 0 ? max(0, min(1, value / maximum)) : 0);
    property <length> knob: root.volume ? 14px : 12px;
    height: 22px;
    Rectangle { y: 8px; height: 6px; width: parent.width; border-radius: 3px;
        background: Theme.rail; border-width: 1px; border-color: Theme.rail-edge;
        Rectangle { x: 0; y: 0; width: round(parent.width / 1px * root.shown) * 1px; height: parent.height; background: Theme.signal; border-radius: 3px; }
    }
    Rectangle {
        width: root.knob; height: self.width; border-radius: self.width / 2;
        x: round((parent.width * root.shown - self.width / 2) / 1px) * 1px;
        y: round((parent.height - self.height) / 2px) * 1px + 1.5px;
        background: root.volume ? Theme.lip : Theme.cyan-lip;
    }
    Rectangle {
        width: root.knob; height: self.width; border-radius: self.width / 2;
        x: round((parent.width * root.shown - self.width / 2) / 1px) * 1px;
        y: round((parent.height - self.height) / 2px) * 1px;
        background: root.volume ? Theme.card-hi : Theme.active;
        border-width: 1px; border-color: root.volume ? Theme.edge : Theme.cyan-edge;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        moved => { root.changed(root.shown * root.maximum, false); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.changed(max(0, min(1, self.mouse-x / self.width)) * root.maximum, false); }
            if event.kind == PointerEventKind.up { root.changed(max(0, min(1, self.mouse-x / self.width)) * root.maximum, true); }
        }
    }
    accessible-role: slider; accessible-value: "" + root.value;
    accessible-value-minimum: 0; accessible-value-maximum: root.maximum;
    accessible-action-set-value(v) => { if v.is-float() { root.changed(max(0,min(root.maximum,v.to-float())),true); } }
    accessible-action-increment => { root.changed(min(root.maximum,root.value + root.maximum/100),true); }
    accessible-action-decrement => { root.changed(max(0,root.value - root.maximum/100),true); }
}
